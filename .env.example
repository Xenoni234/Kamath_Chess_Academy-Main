DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
JWT_SECRET="replace-with-32-plus-character-secret"
JWT_REFRESH_SECRET="replace-with-32-plus-character-refresh-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Kamath Chess Academy"
# DEAD — SMS is not implemented. OTP is email-only via Resend, and nothing in
# the codebase reads either of these. Reserved for a future SMS channel.
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_TEMPLATE_ID="your-msg91-template-id"
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Any Lichess personal access token (no scopes needed) — the opening explorer
# API requires OAuth. Create one at https://lichess.org/account/oauth/token
LICHESS_API_TOKEN="your-lichess-api-token"
RESEND_API_KEY="your-resend-api-key"
# The SENDER. Must be an address on a domain you have verified with Resend —
# a Gmail/Yahoo/Outlook address can never go here, because verification is done
# by adding DNS records and you do not control those providers' DNS.
EMAIL_FROM="Kamath Chess Academy <noreply@kamathchessacademy.com>"

# Where replies land. This CAN be a Gmail address — it is just a header, not a
# sender. Set it to the mailbox the academy actually reads, so a parent hitting
# "Reply" on a verification code or an invoice reaches a human.
EMAIL_REPLY_TO="kamathchessacademy@gmail.com"
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"

# --- Phase 3: durable job queue -------------------------------------------
# A DEDICATED TCP Redis for BullMQ (reports, opponent profiling). Deliberately
# separate from the Upstash REST Redis above. Unset = jobs run inline instead.
QUEUE_REDIS_URL="redis://localhost:6379"

# --- AI provider ------------------------------------------------------------
# openai-compatible | anthropic | ollama | template.
# Unset = openai-compatible when LLM_API_KEY/GROQ_API_KEY is present, else
# anthropic when ANTHROPIC_API_KEY is present, else the free deterministic
# template provider. Ollama is never auto-selected.
AI_PROVIDER="template"

# openai-compatible: any host speaking OpenAI's /chat/completions. Defaults to
# Groq, whose free tier covers ~200 coach explanations a day on gpt-oss-120b
# (30 RPM / 1K RPD / 8K TPM / 200K TPD). Get a key at console.groq.com.
# To move to Cerebras, DeepSeek, OpenRouter or OpenAI, change these three only.
LLM_API_KEY=""
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="openai/gpt-oss-120b"
# gpt-oss is a reasoning model; low keeps a short answer fast. "none" omits the
# Groq-specific reasoning parameters entirely (required on non-Groq hosts,
# which reject unknown fields — this happens automatically off *.groq.com).
LLM_REASONING_EFFORT="low"

# Local fallback. A model small enough to run on the same machine is markedly
# weaker than a hosted one and competes with Stockfish for cores.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# --- Phase 4: Digital Second AI ---------------------------------------------
# Neo4j powers the transposition graph (move-orders that bypass an opponent's
# prep). Unset = the dossier still generates, minus the transposition section.
NEO4J_URI="neo4j://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

# --- Phase 6 v2: mediasoup video SFU (optional) ---
# The live class room uses the self-hosted SFU when enabled; otherwise it falls
# back to embedded Jitsi / the class meetingUrl. In dev it is ON by default
# (listens on 127.0.0.1 — same-machine two-tab testing works). In production set
# MEDIASOUP_ENABLED=true, MEDIASOUP_ANNOUNCED_IP to the server's PUBLIC IP, open
# the UDP port range on the host/firewall, and run a TURN server (coturn) for
# users behind strict NATs.
MEDIASOUP_ENABLED=
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100
CONTACT_NOTIFY_EMAIL=

# How many single-threaded Stockfish engines run in parallel for reports and
# dossiers. Leave unset and the app derives it from the host's available cores
# minus two (capped at 8), which keeps the web server responsive while a dossier
# generates. Set it only to pin a specific number — too high on a small VPS makes
# the whole site hang for the duration of a profiling job.
# ENGINE_CONCURRENCY=4

# How many registration/reset codes one IP may request per hour. Default 30.
# Raise it for a launch day or a large intake session: Indian mobile carriers use
# CGNAT, so a whole class "on their own phones" can still share one public IP, and
# so does everyone on the academy's WiFi. The per-ADDRESS limit (3/hour) is the
# control that protects an individual from being email-bombed, and it is separate.
# OTP_MAX_PER_IP_HOUR=100

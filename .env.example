DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
JWT_SECRET="replace-with-32-plus-character-secret"
JWT_REFRESH_SECRET="replace-with-32-plus-character-refresh-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Kamath Chess Academy"
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_TEMPLATE_ID="your-msg91-template-id"
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Any Lichess personal access token (no scopes needed) — the opening explorer
# API requires OAuth. Create one at https://lichess.org/account/oauth/token
LICHESS_API_TOKEN="your-lichess-api-token"
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Kamath Chess Academy <noreply@example.com>"
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"

# --- Phase 3: durable job queue -------------------------------------------
# A DEDICATED TCP Redis for BullMQ (reports, opponent profiling). Deliberately
# separate from the Upstash REST Redis above. Unset = jobs run inline instead.
QUEUE_REDIS_URL="redis://localhost:6379"

# --- AI provider ------------------------------------------------------------
# anthropic | ollama | template. Unset = anthropic when ANTHROPIC_API_KEY is
# present, otherwise the free deterministic template provider.
AI_PROVIDER="template"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# --- Phase 4: Digital Second AI ---------------------------------------------
# Neo4j powers the transposition graph (move-orders that bypass an opponent's
# prep). Unset = the dossier still generates, minus the transposition section.
NEO4J_URI="neo4j://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PARENT
  COACH
  HR
  HEAD
}

enum TimeFormat {
  BULLET
  BLITZ
  RAPID
  CLASSICAL
}

enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
  ABORT
}

enum GameSource {
  PLATFORM
  LICHESS_IMPORT
  CHESSCOM_IMPORT
}

enum TournamentType {
  ARENA
  SWISS
  ROUND_ROBIN
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  FINISHED
  CANCELLED
}

enum ClassStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  CLASS_REMINDER
  PAYMENT_DUE
  GAME_REPORT_READY
  PUZZLE_AVAILABLE
  TOURNAMENT_STARTING
  SYSTEM
}

enum OpponentSource {
  LICHESS
  CHESSCOM
  MANUAL
  BROADCAST
}

model User {
  id             String            @id @default(cuid())
  username       String            @unique
  email          String            @unique
  mobile         String            @unique
  passwordHash   String
  role           Role              @default(STUDENT)
  isVerified     Boolean           @default(false)
  isActive       Boolean           @default(true)
  fideId         String?           @unique
  lichessId      String?           @unique
  chesscomId     String?           @unique
  avatarUrl      String?
  bio            String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sessions       UserSession[]
  otps           OtpVerification[]
  studentProfile StudentProfile?
  coachProfile   CoachProfile?
  parentLinks    ParentStudent[]   @relation("ParentLinks")
  studentLinks   ParentStudent[]   @relation("StudentLinks")
  ratings        Rating[]
  whiteGames     Game[]            @relation("WhiteGames")
  blackGames     Game[]            @relation("BlackGames")
  gameResults    GameResultRecord[]
  gameReports    GameReport[]
  puzzleAttempts PuzzleAttempt[]
  tournamentRows TournamentPlayer[]
  classEnrollments ClassEnrollment[]
  payments       Payment[]
  notifications  Notification[]
  achievements   Achievement[]
  auditLogs       AuditLog[]
  opponentProfiles OpponentProfile[]
  savedOpenings   SavedOpening[]
  classMessages   Message[]
  attendance       ClassAttendance[] @relation("AttendanceStudent")
  attendanceMarked ClassAttendance[] @relation("AttendanceMarker")
  recordedPayments Payment[]         @relation("PaymentRecorder")
  gameAnnotations  GameAnnotation[]  @relation("GameAnnotations")
  invitesCreated   InviteCode[]      @relation("InviteCodesCreated")
  tournamentRegistrations TournamentRegistration[]
  inviteUsed       InviteCode?       @relation("InviteCodeUsed")

  /// DPDPA consent, stored as timestamps rather than booleans: a boolean cannot
  /// prove *when* consent was given, which is the one thing a regulator asks for.
  /// These used to live only inside an AuditLog JSON blob, and the three mandatory
  /// consents were validated at registration and then thrown away entirely.
  ///
  /// NULL means "registered before consent was recorded" — render it as UNKNOWN,
  /// never as refused. scripts/backfillConsent.ts fills what the audit log can.
  consentVersion          String?
  consentTermsAt          DateTime?
  consentAgeAt            DateTime?
  consentDataProcessingAt DateTime?
  consentMarketing        Boolean   @default(false)
  consentMarketingAt      DateTime?
  consentSms              Boolean   @default(false)
  consentSmsAt            DateTime?

  /// What this person said they were at sign-up, when that is something only the
  /// academy can grant.
  ///
  /// Registration offers Student, Parent, Coach and Staff. The first two are
  /// granted immediately. The other two would hand a stranger the roster, fees or
  /// academy revenue, so they are recorded here instead: the account is created
  /// as a deactivated STUDENT, and staff approve it by setting the real `role`
  /// and reactivating. Login already filters on `isActive`, so nothing is
  /// reachable in the meantime.
  ///
  /// Null means nothing was requested — the ordinary case.
  requestedRole Role?

  /// Set when the identity fields were scrubbed under a DPDPA erasure request.
  /// Erasure is an UPDATE, not a DELETE: financial records (Payment/Invoice) must
  /// survive for statutory retention and still point at this row.
  anonymizedAt DateTime?

  @@index([role])
  @@index([isActive])
  /// Staff review the pending queue by this.
  @@index([requestedRole])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OtpVerification {
  id         String   @id @default(cuid())
  userId     String?
  email      String?
  mobile     String?
  otpHash    String
  purpose    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([mobile])
  @@index([expiresAt])
}

model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())
  parent    User     @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  /// Shown to the student, given to their parent, entered at registration.
  ///
  /// A parent must supply this AND the student's username to sign up, which is
  /// what stops anyone from registering as a stranger's parent and reading a
  /// child's attendance, reports and fees. Deliberately reusable rather than
  /// single-use — most children have two parents — and the student can regenerate
  /// it, which invalidates the old one.
  ///
  /// Null until first viewed; generated lazily so existing rows need no backfill.
  parentCode   String?  @unique
  dateOfBirth  DateTime?
  school       String?
  city         String?
  country      String?
  currentLevel String?
  goals        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoachProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  title          String?
  experience     Int?
  specialization String?
  hourlyRate     Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  batches        Batch[]
  classes        Class[]
}

model Rating {
  id         String     @id @default(cuid())
  userId     String
  format     TimeFormat
  rating     Int        @default(1500)
  rd         Float      @default(350)
  sigma      Float      @default(0.06)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, format])
  @@index([format, rating])
}

model Game {
  id          String             @id @default(cuid())
  whiteUserId String?
  blackUserId String?
  pgn         String
  fen         String?
  moves       String[]           @default([])
  timeControl String?
  timeFormat  TimeFormat
  result      GameResult
  termination String?
  rated       Boolean            @default(false)
  whiteTimeMs Int?
  blackTimeMs Int?
  incrementMs Int?
  lastMoveAt  DateTime?
  tournamentId String?
  source      GameSource         @default(PLATFORM)
  playedAt    DateTime           @default(now())
  createdAt   DateTime           @default(now())
  whiteUser   User?              @relation("WhiteGames", fields: [whiteUserId], references: [id], onDelete: SetNull)
  blackUser   User?              @relation("BlackGames", fields: [blackUserId], references: [id], onDelete: SetNull)
  records     GameResultRecord[]

  // "My games" filters `OR: [whiteUserId, blackUserId]` and sorts playedAt desc.
  // The single-column indexes served the filter but left the sort to an external
  // sort; these composites cover both halves of the OR.
  annotations GameAnnotation[]

  @@index([whiteUserId, playedAt])
  @@index([blackUserId, playedAt])
  @@index([timeFormat, playedAt])
}

model GameResultRecord {
  id           String     @id @default(cuid())
  gameId       String
  userId       String
  result       GameResult
  ratingBefore Int?
  ratingAfter  Int?
  createdAt    DateTime   @default(now())
  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId, createdAt])
}

model GameReport {
  id            String   @id @default(cuid())
  userId        String
  lichessId     String?
  chesscomId    String?
  status        String   @default("pending")
  /// The finished PDF itself. Reports used to live only in /tmp, which is wiped on every
  /// redeploy, so the download said "this report's file has expired — check your email".
  /// Students should not have to dig through email for their own report, so the bytes are
  /// kept here and the download always works. A report PDF is ~150-300 KB.
  pdf           Bytes?
  /// Legacy /tmp path. Kept so reports generated before `pdf` existed still resolve if the
  /// file happens to survive; new reports do not set it.
  pdfUrl        String?
  emailSentAt   DateTime?
  gamesAnalyzed Int      @default(0)
  summary       String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  // /api/reports filters userId and sorts createdAt desc. This model had no
  // index at all, so every request sequentially scanned and then sorted.
  @@index([userId, createdAt])
  @@map("game_reports")
}

model OpeningCache {
  id        String   @id @default(cuid())
  fenHash   String   @unique
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("opening_cache")
}

model Puzzle {
  id          String          @id @default(cuid())
  fen         String
  moves       String
  rating      Int?
  themes      String[]
  source      String?
  createdAt   DateTime        @default(now())
  attempts    PuzzleAttempt[]

  @@index([rating])
  @@index([themes], type: Gin)
}

model PuzzleAttempt {
  id             String   @id @default(cuid())
  puzzleId       String
  userId         String
  isCorrect      Boolean
  attempts       Int      @default(1)
  easinessFactor Float    @default(2.5)
  intervalDays   Int      @default(1)
  repetition     Int      @default(0)
  nextReviewAt   DateTime
  reviewedAt     DateTime @default(now())
  puzzle         Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
  @@index([puzzleId])
}

model Tournament {
  id          String             @id @default(cuid())
  title       String
  description String?
  type        TournamentType
  status      TournamentStatus   @default(UPCOMING)
  startsAt    DateTime
  endsAt      DateTime?

  /// Advertise this on the PUBLIC homepage. Off by default: a tournament run on the
  /// platform for six students is not a marketing item, and opting in should be a
  /// decision rather than the consequence of creating one.
  publicListed Boolean           @default(false)
  /// An over-the-board event the academy is promoting, as opposed to one played here.
  /// Offline events have a venue and an entry fee; online ones do not.
  isOffline   Boolean            @default(false)
  /// Free text, because a prize is not always money — "Scholarships & Trophies" is a
  /// real answer and a Decimal cannot hold it.
  prizePool   String?
  /// "9 Rounds Swiss · Blitz 3+2" — how the event is played, for the public card.
  formatNote  String?

  /// Everything below is shown only to SIGNED-IN users. The public endpoint does not
  /// select these columns at all, so "log in for details" is enforced by what the
  /// server sends rather than by what the page chooses to render.
  venue       String?
  entryFee    String?
  contactInfo String?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  players     TournamentPlayer[]
  registrations TournamentRegistration[]

  @@index([status, startsAt])
}

model TournamentPlayer {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  score        Float      @default(0)
  rank         Int?
  joinedAt     DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([userId])
}

model Batch {
  id          String            @id @default(cuid())
  name        String
  coachId     String?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  coach       CoachProfile?     @relation(fields: [coachId], references: [id], onDelete: SetNull)
  classes     Class[]
  enrollments ClassEnrollment[]

  @@index([coachId])
}

model Class {
  id          String            @id @default(cuid())
  batchId     String?
  coachId     String?
  title       String
  description String?
  status      ClassStatus       @default(SCHEDULED)
  startsAt    DateTime
  endsAt      DateTime
  meetingUrl  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  batch       Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  coach       CoachProfile?     @relation(fields: [coachId], references: [id], onDelete: SetNull)
  enrollments ClassEnrollment[]
  messages    Message[]
  attendance  ClassAttendance[]
  /** When the coach opened the live room (Phase 6 v1). Null = never gone live. */
  liveStartedAt DateTime?

  /// Random room name for the embedded Jitsi call. The room used to be named
  /// `KCA-<class cuid>`, so anyone who could guess or forward a URL could walk
  /// into a class of minors with no KCA account. Generated lazily behind the
  /// authorisation gate and ROTATED every time the coach starts the class, so a
  /// forwarded link dies with the session.
  videoRoomKey String? @unique

  @@index([status, startsAt])
  @@index([batchId])
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  classId   String?
  batchId   String?
  userId    String
  createdAt DateTime @default(now())
  class     Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  batch     Batch?   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([classId])
  @@index([batchId])
}

/** In-class chat message (Phase 6 v1). Sent over Socket.io in the `class:<id>`
 *  room and persisted so late joiners and a post-class review see the history. */
model Message {
  id        String   @id @default(cuid())
  classId   String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classId, createdAt])
  @@map("class_messages")
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("INR")
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?
  /** How an offline payment arrived: CASH / UPI / BANK / CARD / OTHER. Null for
   *  gateway payments, which carry `provider`/`providerRef` instead. */
  method      String?
  /** What the payment is for, e.g. "October tuition". */
  description String?
  note        String?
  dueDate     DateTime?
  /** The staff member who recorded it. Null for gateway-created rows. */
  recordedById String?
  recordedBy   User?        @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice     Invoice?

  /// Razorpay's payment id (`pay_...`). `providerRef` holds the *order* id, which
  /// is the stable idempotency key; this is the settlement reference.
  providerPaymentId String?

  @@index([userId, status])
  @@index([providerRef])
  /// Two webhook deliveries for one order must not create two COMPLETED rows.
  /// Composite rather than a bare unique on providerRef: every offline row is
  /// (null, null), and Postgres allows unlimited rows where any column is NULL.
  @@unique([provider, providerRef])
}

model Invoice {
  id        String   @id @default(cuid())
  paymentId String   @unique
  number    String   @unique
  /// The invoice PDF itself. Same reason as GameReport.pdf: /tmp is wiped on every
  /// redeploy, and a financial record must not depend on a file that disappears.
  pdf       Bytes?
  /// Legacy /tmp path, kept so invoices issued before `pdf` existed still resolve.
  pdfUrl    String?
  issuedAt  DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([type, createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  awardedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, awardedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  /// The viewer's default query is unfiltered, newest-first. Neither index above
  /// serves it: [userId, createdAt] needs a userId prefix and [action] has no sort
  /// component. Cheap to add now, expensive at ten million rows.
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Phase 4 — Digital Second AI
// ---------------------------------------------------------------------------

/**
 * A profiling run against one online opponent. The heavy artifact (opening
 * Trie summary, ranked weaknesses, transposition bypass lines, novelties) is
 * stashed as JSON once the queue job completes; `status` is a plain string and
 * moves pending -> processing -> complete/failed exactly like GameReport.
 *
 * `handle`/`source` are the PRIMARY account and stay denormalised here even
 * though a profile may merge several: the list view, the download filename and
 * every pre-multi-account row depend on them. Invariant: they always equal the
 * `accounts` row with `position = 0`.
 */
model OpponentProfile {
  id            String          @id @default(cuid())
  requestedById String
  handle        String
  source        OpponentSource
  fideId        String?
  /// Real name of the opponent, used to pick their side in pasted OTB games
  /// and as the display label for OTB/manual sources. Null for online-only.
  playerName    String?
  /// Raw PGN the user pasted (up to 15 games), kept so a regenerate reuses the
  /// same games without asking for them again.
  pastedPgn     String?         @db.Text
  colorToPlay   String          @default("white") // side WE play against them
  status        String          @default("pending")
  gamesAnalyzed Int             @default(0)
  ratingSummary Json?
  artifact      Json?
  summary       String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  requestedBy   User            @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  repertoires   RepertoirePlan[]
  accounts      OpponentAccount[]

  @@index([requestedById, createdAt])
  @@index([handle, source])
  @@map("opponent_profiles")
}

/**
 * One online account merged into a dossier — 1..5 per profile, any mix of
 * Lichess and Chess.com, because a player's evidence is usually split across
 * sites.
 *
 * A table rather than a JSON column on the profile: this is job *input*, re-read
 * on every regenerate, and a JSON blob cannot carry the unique constraint. Two
 * copies of the same account in one dossier would silently double that player's
 * weight in every weighted figure.
 *
 * The constraint is a backstop, not the guarantee — Postgres unique indexes are
 * case-sensitive, so "Magnus" and "magnus" both insert. The zod refine on the
 * create route does the case-insensitive check, and the API is the only writer.
 */
model OpponentAccount {
  id        String          @id @default(cuid())
  profileId String
  handle    String
  /// Readable name for MANUAL/BROADCAST accounts whose handle is synthetic
  /// (a FIDE ID or pasted-{n}). Null for online accounts.
  displayName String?
  source    OpponentSource
  /// 0 = primary; mirrors OpponentProfile.handle/source.
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  profile   OpponentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, source, handle])
  @@index([handle, source])
  @@map("opponent_accounts")
}

/**
 * The Claude-authored (or template-fallback) annotated repertoire produced for
 * a profile. `linesJson` is the structured recommended move tree; `summary` is
 * the prose. Latest row per profile is the current plan.
 */
model RepertoirePlan {
  id        String          @id @default(cuid())
  profileId String
  /// The dossier PDF itself. Same reason as GameReport.pdf: /tmp is wiped on every
  /// redeploy, so the download degraded to "this dossier's file has expired".
  pdf       Bytes?
  /// Legacy /tmp path, kept so older rows still resolve if the file survived.
  pdfUrl    String?
  summary   String          @db.Text
  linesJson Json
  createdAt DateTime        @default(now())
  profile   OpponentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("repertoire_plans")
}

/**
 * A generated opening repertoire (Phase 5 Opening Trainer). GLOBAL and cached —
 * a repertoire is identical for every user, so it is keyed by `slug`
 * (normalized name + colour + version) and shared. `artifact` holds the
 * OpeningArtifact, `linesJson` the extended RepertoireLine[], `summary` the AI
 * coaching guide, `pdfUrl` an ephemeral /tmp path.
 */
model OpeningRepertoire {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  eco         String?
  colorToPlay String   @default("white")
  version     Int      @default(1)
  status      String   @default("pending")
  artifact    Json?
  summary     String?  @db.Text
  linesJson   Json?
  /// The guide PDF itself. Same reason as GameReport.pdf and RepertoirePlan.pdf: /tmp is
  /// wiped on every redeploy, so the download degraded to "this repertoire's file has
  /// expired" — served as raw JSON, in a browser tab, to a child.
  pdf         Bytes?
  /// Legacy /tmp path, kept so rows written before `pdf` existed still resolve.
  pdfUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  saved       SavedOpening[]

  @@index([status, updatedAt])
  @@map("opening_repertoires")
}

/** A user's personal shortcut to a global OpeningRepertoire. */
model SavedOpening {
  id           String            @id @default(cuid())
  userId       String
  repertoireId String
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  repertoire   OpeningRepertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  @@unique([userId, repertoireId])
  @@index([userId, createdAt])
  @@map("saved_openings")
}

/**
 * Attendance for one student in one class (Phase 3 completion).
 *
 * Unique per class+student so marking is idempotent — a coach correcting a
 * mistake updates the row rather than creating a second, contradictory one.
 */
model ClassAttendance {
  id         String           @id @default(cuid())
  classId    String
  userId     String
  status     AttendanceStatus @default(PRESENT)
  note       String?
  markedById String?
  markedAt   DateTime         @default(now())
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  user       User             @relation("AttendanceStudent", fields: [userId], references: [id], onDelete: Cascade)
  markedBy   User?            @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([classId, userId])
  @@index([userId, markedAt])
  @@index([classId])
  @@map("class_attendance")
}

/**
 * A public contact-form enquiry.
 *
 * Previously the handler only console.logged the submission and told the sender
 * "received" — every lead was lost, and their name/email/mobile went to the log
 * aggregator in plaintext.
 */
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  mobile    String?
  message   String   @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
  @@map("contact_messages")
}

/// Per-financial-year invoice sequence. India's FY runs April to March, so numbers
/// read KCA-2026-27-0001.
///
/// A counter table rather than "count existing invoices inside a transaction":
/// under Postgres' default Read Committed two concurrent transactions both read N
/// and both write N+1, and one loses to the unique index on Invoice.number.
/// Serializable would fix that but turns every invoice into a retry-on-40001 loop.
/// This is one atomic INSERT ... ON CONFLICT DO UPDATE SET seq = seq + 1 RETURNING
/// seq — race-free in a single round trip.
///
/// Numbers can have GAPS when a job fails after reserving one. That is correct for
/// an invoice sequence: a reserved-then-abandoned number must never be reused.
model InvoiceCounter {
  fy        String   @id
  seq       Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("invoice_counters")
}

/// One row per gateway webhook delivery id (Razorpay's `x-razorpay-event-id`).
/// The handler inserts FIRST; a P2002 means this delivery is a retry and it returns
/// 200 without re-processing. Razorpay retries on any non-2xx, so without this a
/// slow response produces duplicate settlements.
model ProcessedWebhook {
  id         String   @id
  provider   String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@map("processed_webhooks")
}

/// A coach's note attached to one half-move of one game.
///
/// `ply` is 1-based and matches PositionNode.ply in src/lib/engine/analysis.ts —
/// ply 1 is the position AFTER White's first move. Unique per coach+ply so editing
/// a note updates it rather than stacking duplicates, while two coaches may each
/// annotate the same move.
model GameAnnotation {
  id        String   @id @default(cuid())
  gameId    String
  coachId   String
  ply       Int
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  coach     User     @relation("GameAnnotations", fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([gameId, coachId, ply])
  @@index([gameId, ply])
  @@map("game_annotations")
}

/// A single-use code that lets someone register as a coach or academy staff.
///
/// Registration offers those two roles in its dropdown, but choosing one is not
/// enough — a code issued by the academy head must be presented with it. Without
/// this, a public form hands any visitor the student roster, attendance and fee
/// records, which is exactly what it looked like before this existed.
///
/// Single use is enforced at the database level, not by a read-then-write: the
/// consuming update is conditional on `usedAt` still being null, so two people
/// racing the same code produce one success and one rejection rather than two
/// staff accounts.
///
/// Codes are never deleted once used — who was invited as what, by whom, and
/// when they redeemed it, is exactly the sort of thing an academy needs to be
/// able to answer later.
model InviteCode {
  id          String    @id @default(cuid())
  /// The string handed to the invitee, e.g. KCA-7F3K-92QD.
  code        String    @unique
  /// Which role redeeming this grants. COACH or HR only.
  role        Role
  /// Free text for the issuer's own memory — "for Priya, joining in October".
  note        String?
  createdById String
  createdBy   User      @relation("InviteCodesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  /// Null until redeemed. Unique so one account cannot consume two codes.
  usedById    String?   @unique
  usedBy      User?     @relation("InviteCodeUsed", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  /// Null means it does not expire.
  expiresAt   DateTime?
  /// Set when the head withdraws an unused code.
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([usedAt, createdAt])
  @@index([role])
  @@map("invite_codes")
}

/**
 * An entry form for an over-the-board tournament.
 *
 * Separate from `TournamentPlayer`, which is the pairing/standings record for an event
 * played ON the platform. This is the "I would like to come" form for an offline event:
 * the academy needs a name, a contact number and an age to seat someone in a hall, and
 * none of that belongs in a Glicko standings table.
 *
 * Sign-in is required (`userId` is not nullable). That is a DPDPA decision as much as a
 * product one: a registered account has already given the three mandatory consents, so
 * collecting a child's date of birth and phone number against it is covered. A public
 * form open to anyone would be collecting a minor's personal data with no consent record
 * at all.
 *
 * `@@unique([tournamentId, userId])` so a double-tap on Register does not produce two
 * entries — the second write fails rather than quietly duplicating a child in the list.
 */
model TournamentRegistration {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String

  /// As it should appear on the pairing sheet — not necessarily the account's username.
  fullName     String
  /// Age brackets decide sections in junior events.
  dateOfBirth  DateTime?
  phone        String
  /// Free text: a player may quote a FIDE, Lichess or Chess.com rating, or none.
  rating       String?
  fideId       String?
  /// Anything the organiser should know — dietary needs, arriving late, a guardian's name.
  notes        String?

  /// PENDING until staff confirm a place. Not an enum: an academy's own workflow words
  /// change, and a migration to add "WAITLIST" is not worth the ceremony.
  status       String     @default("PENDING")

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
  @@map("tournament_registrations")
}

/**
 * Content the academy owner edits on the public website — the "Our Champions" cards and
 * the coaching team.
 *
 * These used to be arrays hardcoded in the React components, which meant the site
 * advertised six titled players as "our elite academy students" and a "₹1,00,000 prize
 * pool" for a tournament that did not exist. Content that makes claims about real people
 * belongs in the database where the person responsible for it can change it, not in a
 * component only a developer can edit.
 *
 * Photos are `Bytes` on the row, like GameReport.pdf and the others. Cloudinary's env vars
 * exist in .env.example but nothing has ever used them, and adding an image service for a
 * handful of headshots would be a new dependency for no gain. `photoType` carries the MIME
 * so the serving route does not have to guess.
 */
model SiteAchievement {
  id           String   @id @default(cuid())
  /// The student's name as it should appear publicly.
  name         String
  /// What they did — "Won Gold at the Asian Continental Women Championship".
  achievement  String
  achievedOn   DateTime
  photo        Bytes?
  photoType    String?
  /// Lowest first. Lets the owner put the newest or proudest result at the top without
  /// depending on the date.
  displayOrder Int      @default(0)
  /// Unpublished rows stay in the admin list but never reach the public endpoint, so a
  /// half-written entry is not a live claim.
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, displayOrder])
  @@map("site_achievements")
}

/**
 * A coach on the public "our team" section.
 *
 * Deliberately NOT the `CoachProfile` of a `User`. A coach can be introduced on the website
 * before they have a login, and a staff account can exist without being advertised — the
 * two lists are related but not the same, and forcing them together would mean creating an
 * account to put a face on a page.
 */
model SiteCoach {
  id           String   @id @default(cuid())
  name         String
  /// Free text — "FIDE Instructor", "National Arbiter", or simply "Coach". The academy is
  /// responsible for the accuracy of anything it puts here.
  title        String?
  bio          String?
  photo        Bytes?
  photoType    String?
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, displayOrder])
  @@map("site_coaches")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PARENT
  COACH
  HR
  HEAD
}

enum TimeFormat {
  BULLET
  BLITZ
  RAPID
  CLASSICAL
}

enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
  ABORT
}

enum GameSource {
  PLATFORM
  LICHESS_IMPORT
  CHESSCOM_IMPORT
}

enum TournamentType {
  ARENA
  SWISS
  ROUND_ROBIN
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  FINISHED
  CANCELLED
}

enum ClassStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  CLASS_REMINDER
  PAYMENT_DUE
  GAME_REPORT_READY
  PUZZLE_AVAILABLE
  TOURNAMENT_STARTING
  SYSTEM
}

enum OpponentSource {
  LICHESS
  CHESSCOM
  MANUAL
  BROADCAST
}

model User {
  id             String            @id @default(cuid())
  username       String            @unique
  email          String            @unique
  mobile         String            @unique
  passwordHash   String
  role           Role              @default(STUDENT)
  isVerified     Boolean           @default(false)
  isActive       Boolean           @default(true)
  fideId         String?           @unique
  lichessId      String?           @unique
  chesscomId     String?           @unique
  avatarUrl      String?
  bio            String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sessions       UserSession[]
  otps           OtpVerification[]
  studentProfile StudentProfile?
  coachProfile   CoachProfile?
  parentLinks    ParentStudent[]   @relation("ParentLinks")
  studentLinks   ParentStudent[]   @relation("StudentLinks")
  ratings        Rating[]
  whiteGames     Game[]            @relation("WhiteGames")
  blackGames     Game[]            @relation("BlackGames")
  gameResults    GameResultRecord[]
  gameReports    GameReport[]
  puzzleAttempts PuzzleAttempt[]
  tournamentRows TournamentPlayer[]
  classEnrollments ClassEnrollment[]
  payments       Payment[]
  notifications  Notification[]
  achievements   Achievement[]
  auditLogs       AuditLog[]
  opponentProfiles OpponentProfile[]
  savedOpenings   SavedOpening[]

  @@index([role])
  @@index([isActive])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OtpVerification {
  id         String   @id @default(cuid())
  userId     String?
  email      String?
  mobile     String?
  otpHash    String
  purpose    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([mobile])
  @@index([expiresAt])
}

model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())
  parent    User     @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  dateOfBirth  DateTime?
  school       String?
  city         String?
  country      String?
  currentLevel String?
  goals        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoachProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  title          String?
  experience     Int?
  specialization String?
  hourlyRate     Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  batches        Batch[]
  classes        Class[]
}

model Rating {
  id         String     @id @default(cuid())
  userId     String
  format     TimeFormat
  rating     Int        @default(1500)
  rd         Float      @default(350)
  sigma      Float      @default(0.06)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, format])
  @@index([format, rating])
}

model Game {
  id          String             @id @default(cuid())
  whiteUserId String?
  blackUserId String?
  pgn         String
  fen         String?
  moves       String[]           @default([])
  timeControl String?
  timeFormat  TimeFormat
  result      GameResult
  termination String?
  rated       Boolean            @default(false)
  whiteTimeMs Int?
  blackTimeMs Int?
  incrementMs Int?
  lastMoveAt  DateTime?
  tournamentId String?
  source      GameSource         @default(PLATFORM)
  playedAt    DateTime           @default(now())
  createdAt   DateTime           @default(now())
  whiteUser   User?              @relation("WhiteGames", fields: [whiteUserId], references: [id], onDelete: SetNull)
  blackUser   User?              @relation("BlackGames", fields: [blackUserId], references: [id], onDelete: SetNull)
  records     GameResultRecord[]

  // "My games" filters `OR: [whiteUserId, blackUserId]` and sorts playedAt desc.
  // The single-column indexes served the filter but left the sort to an external
  // sort; these composites cover both halves of the OR.
  @@index([whiteUserId, playedAt])
  @@index([blackUserId, playedAt])
  @@index([timeFormat, playedAt])
}

model GameResultRecord {
  id           String     @id @default(cuid())
  gameId       String
  userId       String
  result       GameResult
  ratingBefore Int?
  ratingAfter  Int?
  createdAt    DateTime   @default(now())
  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId, createdAt])
}

model GameReport {
  id            String   @id @default(cuid())
  userId        String
  lichessId     String?
  chesscomId    String?
  status        String   @default("pending")
  pdfUrl        String?
  emailSentAt   DateTime?
  gamesAnalyzed Int      @default(0)
  summary       String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  // /api/reports filters userId and sorts createdAt desc. This model had no
  // index at all, so every request sequentially scanned and then sorted.
  @@index([userId, createdAt])
  @@map("game_reports")
}

model OpeningCache {
  id        String   @id @default(cuid())
  fenHash   String   @unique
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("opening_cache")
}

model Puzzle {
  id          String          @id @default(cuid())
  fen         String
  moves       String
  rating      Int?
  themes      String[]
  source      String?
  createdAt   DateTime        @default(now())
  attempts    PuzzleAttempt[]

  @@index([rating])
  @@index([themes], type: Gin)
}

model PuzzleAttempt {
  id             String   @id @default(cuid())
  puzzleId       String
  userId         String
  isCorrect      Boolean
  attempts       Int      @default(1)
  easinessFactor Float    @default(2.5)
  intervalDays   Int      @default(1)
  repetition     Int      @default(0)
  nextReviewAt   DateTime
  reviewedAt     DateTime @default(now())
  puzzle         Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
  @@index([puzzleId])
}

model Tournament {
  id          String             @id @default(cuid())
  title       String
  description String?
  type        TournamentType
  status      TournamentStatus   @default(UPCOMING)
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  players     TournamentPlayer[]

  @@index([status, startsAt])
}

model TournamentPlayer {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  score        Float      @default(0)
  rank         Int?
  joinedAt     DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([userId])
}

model Batch {
  id          String            @id @default(cuid())
  name        String
  coachId     String?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  coach       CoachProfile?     @relation(fields: [coachId], references: [id], onDelete: SetNull)
  classes     Class[]
  enrollments ClassEnrollment[]

  @@index([coachId])
}

model Class {
  id          String            @id @default(cuid())
  batchId     String?
  coachId     String?
  title       String
  description String?
  status      ClassStatus       @default(SCHEDULED)
  startsAt    DateTime
  endsAt      DateTime
  meetingUrl  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  batch       Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  coach       CoachProfile?     @relation(fields: [coachId], references: [id], onDelete: SetNull)
  enrollments ClassEnrollment[]

  @@index([status, startsAt])
  @@index([batchId])
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  classId   String?
  batchId   String?
  userId    String
  createdAt DateTime @default(now())
  class     Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  batch     Batch?   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([classId])
  @@index([batchId])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("INR")
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice     Invoice?

  @@index([userId, status])
  @@index([providerRef])
}

model Invoice {
  id        String   @id @default(cuid())
  paymentId String   @unique
  number    String   @unique
  pdfUrl    String?
  issuedAt  DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([type, createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  awardedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, awardedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Phase 4 — Digital Second AI
// ---------------------------------------------------------------------------

/**
 * A profiling run against one online opponent. The heavy artifact (opening
 * Trie summary, ranked weaknesses, transposition bypass lines, novelties) is
 * stashed as JSON once the queue job completes; `status` is a plain string and
 * moves pending -> processing -> complete/failed exactly like GameReport.
 *
 * `handle`/`source` are the PRIMARY account and stay denormalised here even
 * though a profile may merge several: the list view, the download filename and
 * every pre-multi-account row depend on them. Invariant: they always equal the
 * `accounts` row with `position = 0`.
 */
model OpponentProfile {
  id            String          @id @default(cuid())
  requestedById String
  handle        String
  source        OpponentSource
  fideId        String?
  /// Real name of the opponent, used to pick their side in pasted OTB games
  /// and as the display label for OTB/manual sources. Null for online-only.
  playerName    String?
  /// Raw PGN the user pasted (up to 15 games), kept so a regenerate reuses the
  /// same games without asking for them again.
  pastedPgn     String?         @db.Text
  colorToPlay   String          @default("white") // side WE play against them
  status        String          @default("pending")
  gamesAnalyzed Int             @default(0)
  ratingSummary Json?
  artifact      Json?
  summary       String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  requestedBy   User            @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  repertoires   RepertoirePlan[]
  accounts      OpponentAccount[]

  @@index([requestedById, createdAt])
  @@index([handle, source])
  @@map("opponent_profiles")
}

/**
 * One online account merged into a dossier — 1..5 per profile, any mix of
 * Lichess and Chess.com, because a player's evidence is usually split across
 * sites.
 *
 * A table rather than a JSON column on the profile: this is job *input*, re-read
 * on every regenerate, and a JSON blob cannot carry the unique constraint. Two
 * copies of the same account in one dossier would silently double that player's
 * weight in every weighted figure.
 *
 * The constraint is a backstop, not the guarantee — Postgres unique indexes are
 * case-sensitive, so "Magnus" and "magnus" both insert. The zod refine on the
 * create route does the case-insensitive check, and the API is the only writer.
 */
model OpponentAccount {
  id        String          @id @default(cuid())
  profileId String
  handle    String
  /// Readable name for MANUAL/BROADCAST accounts whose handle is synthetic
  /// (a FIDE ID or pasted-{n}). Null for online accounts.
  displayName String?
  source    OpponentSource
  /// 0 = primary; mirrors OpponentProfile.handle/source.
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  profile   OpponentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, source, handle])
  @@index([handle, source])
  @@map("opponent_accounts")
}

/**
 * The Claude-authored (or template-fallback) annotated repertoire produced for
 * a profile. `linesJson` is the structured recommended move tree; `summary` is
 * the prose. Latest row per profile is the current plan.
 */
model RepertoirePlan {
  id        String          @id @default(cuid())
  profileId String
  pdfUrl    String?
  summary   String          @db.Text
  linesJson Json
  createdAt DateTime        @default(now())
  profile   OpponentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("repertoire_plans")
}

/**
 * A generated opening repertoire (Phase 5 Opening Trainer). GLOBAL and cached —
 * a repertoire is identical for every user, so it is keyed by `slug`
 * (normalized name + colour + version) and shared. `artifact` holds the
 * OpeningArtifact, `linesJson` the extended RepertoireLine[], `summary` the AI
 * coaching guide, `pdfUrl` an ephemeral /tmp path.
 */
model OpeningRepertoire {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  eco         String?
  colorToPlay String   @default("white")
  version     Int      @default(1)
  status      String   @default("pending")
  artifact    Json?
  summary     String?  @db.Text
  linesJson   Json?
  pdfUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  saved       SavedOpening[]

  @@index([status, updatedAt])
  @@map("opening_repertoires")
}

/** A user's personal shortcut to a global OpeningRepertoire. */
model SavedOpening {
  id           String            @id @default(cuid())
  userId       String
  repertoireId String
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  repertoire   OpeningRepertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  @@unique([userId, repertoireId])
  @@index([userId, createdAt])
  @@map("saved_openings")
}
